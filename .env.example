# ── Supabase ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI Providers ────────────────────────────────────────
ASSEMBLYAI_API_KEY=your-assemblyai-key
NVIDIA_NIM_API_KEY=your-nvidia-nim-key
# Optional fallback providers:
# GROQ_API_KEY=your-groq-key
# OPENAI_API_KEY=your-openai-key
# GOOGLE_AI_STUDIO_KEY=your-google-ai-key

# ── LinkedIn OAuth ──────────────────────────────────────
LINKEDIN_CLIENT_ID=your-linkedin-app-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-app-client-secret
LINKEDIN_REDIRECT_URI=https://your-deployment.vercel.app/api/auth/linkedin/callback

# ── Email (Resend) ──────────────────────────────────────
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=VoicePost <noreply@yourdomain.com>

# ── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app
